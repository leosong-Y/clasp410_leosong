def rk45_solver(function, N_initial, time):
    """
    Solve population dynamics using RK45.

    function: Function that computes the population rates.
    N_initial: Initial state vector, such as [N1, N2] or [x, y, z].
    time: Requested output times, in the model's time units.
    """
    solution = solve_ivp(
        function,
        (time[0], time[-1]),
        N_initial,
        method="RK45",
        t_eval=time,
        rtol=1e-8,
        atol=1e-10
    )

    if not solution.success:
        raise RuntimeError(solution.message)

    return solution.t, solution.y.T

