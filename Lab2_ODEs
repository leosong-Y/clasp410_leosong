# Lorenz model
def lorenz(t, state, sigma=10, b=8 / 3, r=23):
    """
    Compute the Lorenz rates of change.

    t: Time in model units.
    state: Current values [x, y, z].
    sigma, b, r: Lorenz model parameters.
    """
    x, y, z = state

    dx_dt = sigma * (y - x)
    dy_dt = x * (r - z) - y
    dz_dt = x * y - b * z

    return np.array([dx_dt, dy_dt, dz_dt])


