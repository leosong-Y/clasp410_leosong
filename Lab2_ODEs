def euler_solver(function,N_initial, dt, t_final):
    """
    Solve the population dynamics using the Euler method.

    N_initial: Initial population densities [N1, N2].
    dt: Time steps in years.
    t_final: The duration of the simulation in years.
    function: The function that computes the rates of change (competition or predation).
    """

    n_steps = int(t_final / dt)
    time = np.arange(n_steps + 1) * dt

    population = np.zeros((n_steps + 1, len(N_initial)))
    population[0] = N_initial

    for i in range(n_steps):
        rates = function(time[i], population[i])
        population[i + 1] = population[i] + rates * dt

    return time, population

