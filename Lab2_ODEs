def competition(t, N, a=1, b=2, c=1, d=3):
    """
    compute the Lotka-Volterra rates for two competing species.

    t: Time in years.
    N: Current population densities [N1, N2].
    a: Growth coefficient for species 1.
    b: Competition coefficient for species 1.
    c: Growth coefficient for species 2.
    d: Competition coefficient for species 2.
    """
    N1, N2 = N
    dN1_dt = a * N1 * (1 - N1) - b * N1 * N2
    dN2_dt = c * N2 * (1 - N2) - d * N1 * N2
    return np.array([dN1_dt, dN2_dt])

def predation(t, N, a=1, b=2, c=1, d=3):
    """
    compute the Lotka-Volterra rates for a predator-prey system.

    t: Time in years.
    N: Current population densities [N1, N2].
    a: Growth coefficient for prey.
    b: Predation coefficient.
    c: Death coefficient for predators.
    d: Predator growth coefficient due to consuming prey.
    """
    N1, N2 = N
    dN1_dt = a * N1 - b * N1 * N2
    dN2_dt = -c * N2 + d * N1 * N2
    return np.array([dN1_dt, dN2_dt])

