# Physical constants and shared model/experiment settings are defined once.
YEAR = 365.0 * 24 * 3600
RADIUS = 6_378_000.0
RHO = 1020.0
C_HANDOUT = 4.2e6
DEPTH = 50.0
HEAT_FACTOR = RHO * C_HANDOUT * DEPTH
SIGMA = 5.67e-8
S0 = 1370.0
KELVIN_OFFSET = 273.15
NPOINTS = 18
DEFAULT_DT = 1.0
REFERENCE_YEARS = 10000.0
MAX_EQUIL_YEARS = 200000.0
DEFAULT_DIFFUSIVITY = 100.0
DEFAULT_EMISSIVITY = 1.0
DEFAULT_GAMMA = 1.0
DEFAULT_BOUNDARY = 'lecture'
ALBEDO_GROUND = 0.3
ALBEDO_ICE = 0.6
ICE_THRESHOLD = -10.0
EQUIL_TOL = 1e-7
FIT_TOL = 1e-10
FIT_GRADIENT_TOL = 1e-8
STEADY_SOLVER_TOL = 1e-12
STEADY_RESIDUAL_TOL = 1e-5
MAX_STEADY_EVALUATIONS = 200
STEADY_TEMPERATURE_BOUNDS = (-KELVIN_OFFSET + 0.001, 2000.0)
DIFFUSIVITY_MAX = 150.0
DIFFUSIVITY_SWEEP_STEP = 10.0
EMISSIVITY_SWEEP_STEP = 0.1
FIT_MIN_EMISSIVITY = 0.01
FIT_INITIAL_GUESS = (35.0, 0.7)
RMSE_GRID_POINTS = 31
HOT_INITIAL_C = 60.0
COLD_INITIAL_C = -60.0
